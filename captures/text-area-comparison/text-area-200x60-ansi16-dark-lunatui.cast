[0, "o", "\u001b[?1049h\u001b[?25l\u001b[?2026h\u001b[1;1H\u001b[38;5;15;48;5;0m release-notes.md \u001b[38;5;7m                                                                                                                                                                                      \u001b[2;1H                                                                                                                                                                                                        \u001b[3;1H\u001b[38;5;6m 1 \u001b[38;5;7m# lunatui v0.1.20                                                                                                                                                                                    \u001b[4;1H\u001b[38;5;6m 2 \u001b[38;5;7m                                                                                                                                                                                                     \u001b[5;1H\u001b[38;5;6m 3 \u001b[38;5;7m## Highlights                                                                            "]
[0.000, "o", "                                                                                                            \u001b[6;1H\u001b[38;5;6m 4 \u001b[38;5;7m                                                                                                                                                                                                     \u001b[7;1H\u001b[38;5;6m 5 \u001b[38;5;7m- Native multi-line editing with undo and redo                                                                                                                                                       \u001b[8;1H\u001b[38;5;6m 6 \u001b[38;5;7m- Search, directed selection, and bracketed paste                                                                                                                                                    \u001b[9;1H\u001b[38;5;6m 7 \u001b[38;5;7m- Emacs and Vim keymaps through the runtime registry                                                                                                                                                 \u001b[10;1H\u001b[38;5;6m 8 \u001b"]
[0.001, "o", "[38;5;7m                                                                                                                                                                                                     \u001b[11;1H\u001b[38;5;6m 9 \u001b[38;5;7m## Theme                                                                                                                                                                                             \u001b[12;1H\u001b[38;5;6m10 \u001b[38;5;7m                                                                                                                                                                                                     \u001b[13;1H\u001b[38;5;6m11 \u001b[38;5;7mGraphite tokens style the cursor, selection, search marks, and gutter.                                                                                                                               \u001b[14;1H\u001b[38;5;6m12 \u001b[38;5;7mThe viewport follows the cursor and keeps its preferred display column.                                             "]
[0.000, "o", "                                                                                 \u001b[15;1H\u001b[38;5;6m13 \u001b[38;5;7m                                                                                                                                                                                                     \u001b[16;1H\u001b[38;5;6m14 \u001b[38;5;7m## Editing                                                                                                                                                                                           \u001b[17;1H\u001b[38;5;6m15 \u001b[38;5;7m                                                                                                                                                                                                     \u001b[18;1H\u001b[38;5;6m16 \u001b[38;5;7mArrow keys move by grapheme; Shift extends a directed selection.                                                                                                                                     \u001b[19;1H\u001b[38;5;6m17 \u001b[38;5;7mPaste arrives a"]
[0.000, "o", "s one undoable edit, even when split into chunks.                                                                                                                                     \u001b[20;1H\u001b[38;5;6m18 \u001b[38;5;7mUndo, redo, and search stay local to this editor.                                                                                                                                                    \u001b[21;1H\u001b[38;5;6m19 \u001b[38;5;7m                                                                                                                                                                                                     \u001b[22;1H\u001b[38;5;6m20 \u001b[38;5;7m## Release checklist                                                                                                                                                                                 \u001b[23;1H\u001b[38;5;6m21 \u001b[38;5;7m                                                                                                                                           "]
