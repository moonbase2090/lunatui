[0, "o", "\u001b[?1049h\u001b[?25l\u001b[1;1H\u001b[38;5;0;48;5;0m╭ release-notes.md ────────────────────────────────────────────────────────────╮\u001b[2;1H│\u001b[38;5;7;48;5;0m# lunatui v0.1.11                                                             \u001b[38;5;0;48;5;0m│\u001b[3;1H│\u001b[38;5;7;48;5;0m                                                                              \u001b[38;5;0;48;5;0m│\u001b[4;1H│\u001b[38;5;7;48;5;0m## Highlights                                                                 \u001b[38;5;0;48;5;0m│\u001b[5;1H│\u001b[38;5;7;48;5;0m                                                                              \u001b[38;5;0;48;5;0m│\u001b[6;1H│\u001b[38;5;7;48;5;0m- Native multi-line editing with undo and redo                                \u001b[38;5;0;48;5;0m│\u001b[7;1H│\u001b[38;5;7;48;5;0m- Search, directed selection, and bracketed paste                             \u001b[38;5;0;48;5;0m│\u001b[8;1H│\u001b[38;5;7;48;5;0m- Emacs and Vim keymaps thr"]
[0.000, "o", "ough the runtime registry                          \u001b[38;5;0;48;5;0m│\u001b[9;1H│\u001b[38;5;7;48;5;0m                                                                              \u001b[38;5;0;48;5;0m│\u001b[10;1H│\u001b[38;5;7;48;5;0m## Theme                                                                      \u001b[38;5;0;48;5;0m│\u001b[11;1H│\u001b[38;5;7;48;5;0m                                                                              \u001b[38;5;0;48;5;0m│\u001b[12;1H│\u001b[38;5;7;48;5;0mGraphite tokens style the cursor, selection, search marks, and gutter.        \u001b[38;5;0;48;5;0m│\u001b[13;1H│\u001b[38;5;7;48;5;0mThe viewport follows the cursor and keeps its preferred display column.       \u001b[38;5;0;48;5;0m│\u001b[14;1H│\u001b[38;5;7;48;5;0m                                                                              \u001b[38;5;0;48;5;0m│\u001b[15;1H│\u001b[38;5;7;48;5;0m## Editing                                                                    \u001b[38;5;0;48;5;0m│\u001b[16;1H│\u001b[38;5;7;48;5;0m                                                                    "]
[0.000, "o", "          \u001b[38;5;0;48;5;0m│\u001b[17;1H│\u001b[38;5;7;48;5;0mArrow keys move by grapheme; Shift extends a directed selection.              \u001b[38;5;0;48;5;0m│\u001b[18;1H│\u001b[38;5;7;48;5;0mPaste arrives as one undoable edit, even when split into chunks.              \u001b[38;5;0;48;5;0m│\u001b[19;1H│\u001b[38;5;7;48;5;0mUndo, redo, and search stay local to this editor.                             \u001b[38;5;0;48;5;0m│\u001b[20;1H│\u001b[38;5;7;48;5;0m                                                                              \u001b[38;5;0;48;5;0m│\u001b[21;1H│\u001b[38;5;7;48;5;0m## Release checklist                                                          \u001b[38;5;0;48;5;0m│\u001b[22;1H│\u001b[38;5;7;48;5;0m                                                                              \u001b[38;5;0;48;5;0m│\u001b[23;1H│\u001b[38;5;7;48;5;0m- [x] Grapheme-safe movement                                                  \u001b[38;5;0;48;5;0m│\u001b[24;1H╰─────────────────────────────────────────"]
