#!/bin/sh
set -eu

cd "$(git rev-parse --show-toplevel)"

if ! git diff --cached --name-only -z --diff-filter=ACMR |
    awk 'BEGIN { RS = "\0" } /\.rs$/ { found = 1 } END { exit found ? 0 : 1 }'; then
  exit 0
fi

git diff --cached --name-only -z --diff-filter=ACMR |
  awk 'BEGIN { RS = "\0"; ORS = "\0" } /\.rs$/ { print }' |
  xargs -0 sh -c '
    for path in "$@"; do
      case "$path" in
        *'"'"'
'"'"'*)
          printf "pre-commit: staged path contains a newline; rename the file\n" >&2
          exit 1
          ;;
      esac
      if ! git diff --quiet -- "$path"; then
        printf "pre-commit: %s has unstaged changes; stage the full file or restore\n" "$path" >&2
        exit 1
      fi
      if ! cargo fmt --check -- "$path"; then
        printf "pre-commit: rustfmt check failed; run: cargo fmt --all\n" >&2
        exit 1
      fi
    done
  ' _
