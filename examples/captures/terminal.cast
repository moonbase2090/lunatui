14;244m                                      \u001b[38;2;38;42;50m\u2502\u001b[38;2;205;214;244m \u001b[38;2;180;188;250m\u2502\u001b[38;2;205;214;244m                                                                           \u001b[38;2;180;188;250m\u2502\u001b[38;2;205;214;244m \u001b[14;1H \u001b[38;2;38;42;50m\u2502\u001b[38;2;205;214;244m    #[test]                           \u001b[38;2;38;42;50m\u2502\u001b[38;2;205;214;244m \u001b[38;2;180;188;250m\u2502\u001b[38;2;205;214;244m                                                                           \u001b[38;2;180;188;250m\u2502\u001b[38;2;205;214;244m \u001b[15;1H \u001b[38;2;38;42;50m\u2502\u001b[38;2;205;214;244m    fn adds_positive() {              \u001b[38;2;38;42;50m\u2502\u001b[38;2;205;214;244m \u001b[38;2;180;188;250m\u2502\u001b[38;2;205;214;244m                                                                           \u001b[38;2;180;188;250m\u2502\u001b[38;2;205;214;244m \u001b[16;1H \u001b[38;2;38;42;50m\u2502\u001b[38;2;205;214;244m        assert_eq!(add(2, 3), 5);     \u001b[38;2;38;42;50m\u2502\u001b[38;2;205;214;244m \u001b[38;2;180;188;250m\u2502\u001b[38;2;205;214;244m                                                                           \u001b[38;2;180;188;250m\u2502\u001b[38;2;205;214;244m \u001b[17;1H \u001b[38;2;38;42;50m\u2502\u001b[38;2;205;214;244m    }                                 \u001b[38;2;38;42;50m\u2502\u001b[38;2;205;214;244m \u001b[38;2;180;188;250m\u2502\u001b[38;2;205;214;244m                                                                           \u001b[38;2;180;188;250m\u2502\u001b[38;2;205;214;244m \u001b[18;1H \u001b[38;2;38;42;50m\u2502\u001b[38;2;205;214;244m                                      \u001b[38;2;38;42;50m\u2502\u001b[38;2;205;214;244m \u001b[38;2;180;188;250m\u2502\u001b[38;2;205;214;244m                                                                           \u001b[38;2;180;188;250m\u2502\u001b[38;2;205;214;244m \u001b[19;1H \u001b[38;2;38;42;50m\u2502\u001b[38;2;205;214;244m    #[test]                           \u001b[38;2;38;42;50m\u2502\u001b[38;2;205;214;244m \u001b[38;2;180;188;250m\u2502\u001b[38;2;205;214;244m                                                                           \u001b[38;2;180;188;250m\u2502\u001b[38;2;205;214;244m \u001b[20;1H \u001b[38;2;38;42;50m\u2502\u001b[38;2;205;214;244m    fn adds_negative() {              \u001b[38;2;38;42;50m\u2502\u001b[38;2;205;214;244m \u001b[38;2;180;188;250m\u2502\u001b[38;2;205;214;244m                                                                           \u001b[38;2;180;188;250m\u2502\u001b[38;2;205;214;244m \u001b[21;1H \u001b[38;2;38;42;50m\u2502\u001b[38;2;205;214;244m        assert_eq!(add(-4, 1), -3);   \u001b[38;2;38;42;50m\u2502\u001b[38;2;205;214;244m \u001b[38;2;180;188;250m\u2502\u001b[38;2;205;214;244m                                                                           \u001b[38;2;180;188;250m\u2502\u001b[38;2;205;214;244m \u001b[22;1H \u001b[38;2;38;42;50m\u2502\u001b[38;2;205;214;244m    }                                 \u001b[38;2;38;42;50m\u2502\u001b[38;2;205;214;244m \u001b[38;2;180;188;250m\u2502\u001b[38;2;205;214;244m                                                                           \u001b[38;2;180;188;250m\u2502\u001b[38;2;205;214;244m \u001b[23;1H \u001b[38;2;38;42;50m\u2502\u001b[38;2;205;214;244m}                                     \u001b[38;2;38;42;50m\u2502\u001b[38;2;205;214;244m \u001b[38;2;180;188;250m\u2502\u001b[38;2;205;214;244m                                                                           \u001b[38;2;180;188;250m\u2502\u001b[38;2;205;214;244m \u001b[24;1H \u001b[38;2;38;42;50m\u2502\u001b[38;2;205;214;244m                                      \u001b[38;2;38;42;50m\u2502\u001b[38;2;205;214;244m \u001b[38;2;180;188;250m\u2502\u001b[38;2;205;214;244m                                                                           \u001b[38;2;180;188;250m\u2502\u001b[38;2;205;214;244m \